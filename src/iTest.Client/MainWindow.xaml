<Window x:Class="ITest.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iTest" Icon="app.ico"
        Style="{StaticResource AppWindow}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Thanh tiêu đề chung -->
        <Border x:Name="TopBar" Background="#0F172A" Padding="20,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Image Source="app.ico" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="iTest" Foreground="White" FontWeight="Bold" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Ứng dụng thí sinh" Foreground="#CBD5E1" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="MachineInfo" Foreground="#CBD5E1" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- 1. Tìm phòng thi -->
        <Grid x:Name="FindPanel" Grid.Row="1">
            <Border Style="{StaticResource CardBorder}" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
                <StackPanel>
                    <Grid Width="84" Height="84" HorizontalAlignment="Center">
                        <Ellipse x:Name="Wave1" Stroke="#93C5FD" StrokeThickness="2" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Width="56" Height="56" Fill="{StaticResource PrimarySoft}"/>
                        <Path Data="M12,10 A2,2 0 1 1 12,14 A2,2 0 1 1 12,10 M16.2,7.8 A6,6 0 0 1 16.2,16.2 M7.8,16.2 A6,6 0 0 1 7.8,7.8 M19,5 A10,10 0 0 1 19,19 M5,19 A10,10 0 0 1 5,5"
                              Stroke="{StaticResource Primary}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="28" Height="28" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="Tìm phòng thi" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock x:Name="ScanText" Style="{StaticResource Hint}" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <ListBox x:Name="RoomList" Margin="0,16,0,0" MinHeight="140" BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch" SelectionChanged="RoomList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12" Margin="0,4" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="White">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" CornerRadius="999" Padding="10,3" Background="{Binding BadgeBg}">
                                            <TextBlock Text="{Binding BadgeText}" Foreground="{Binding BadgeFg}" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15"/>
                                            <TextBlock Text="{Binding Meta}" Style="{StaticResource Hint}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" TextAlignment="Center">Hoặc nhập địa chỉ máy chủ:</TextBlock>
                    <DockPanel Margin="0,6,0,0">
                        <Button Content="Kết nối" DockPanel.Dock="Right" Margin="8,0,0,0" Click="ManualConnect_Click"/>
                        <TextBox x:Name="ManualHost" ToolTip="Ví dụ 192.168.10.2"/>
                    </DockPanel>
                    <Button x:Name="JoinBtn" Content="Vào phòng thi" Style="{StaticResource BtnPrimary}" Margin="0,16,0,0" MinHeight="46" IsEnabled="False" Click="Join_Click"/>
                    <TextBlock x:Name="FindError" Foreground="{StaticResource Bad}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <Button Content="Thoát" Style="{StaticResource BtnGhost}" HorizontalAlignment="Center" Margin="0,4,0,0" Click="Quit_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. Nội quy + thông tin thí sinh -->
        <ScrollViewer x:Name="InfoPanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24" MaxWidth="1200">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardBorder}" Padding="26">
                    <StackPanel>
                        <TextBlock Text="Nội quy phòng thi" Style="{StaticResource H1}"/>
                        <TextBlock x:Name="RoomLine" Style="{StaticResource Hint}" Margin="0,4,0,14"/>
                        <ItemsControl x:Name="RulesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,10">
                                        <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="8" Background="{StaticResource PrimarySoft}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding N}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#1E3A8A" FontSize="12"/>
                                        </Border>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="12,3,0,0" FontSize="14"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="26">
                    <StackPanel>
                        <TextBlock Text="Thông tin thí sinh" Style="{StaticResource H1}"/>
                        <TextBlock Text="Điền đủ thông tin để giám thị đối chiếu danh sách" Style="{StaticResource Hint}" Margin="0,4,0,6"/>
                        <TextBlock Text="Số báo danh *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="SbdBox"/>
                        <TextBlock Text="Họ và tên *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="NameBox"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Ngày sinh *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="DobBox" MaxLength="10" TextChanged="DobBox_TextChanged" ToolTip="dd/mm/yyyy"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Lớp *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="ClassBox"/>
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="AgreeBox" Margin="0,16,0,0" IsChecked="True">
                            <TextBlock TextWrapping="Wrap">Tôi đã đọc và cam kết tuân thủ nội quy phòng thi.</TextBlock>
                        </CheckBox>
                        <TextBlock x:Name="InfoError" Foreground="{StaticResource Bad}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <Button x:Name="RegisterBtn" Content="Vào phòng chờ" Style="{StaticResource BtnPrimary}" MinHeight="50" Margin="0,16,0,0" Click="Register_Click"/>
                        <Button x:Name="QuitInfoBtn" Content="Thoát" Style="{StaticResource BtnGhost}" HorizontalAlignment="Center" Margin="0,6,0,0" Click="Quit_Click"/>
                        <Border x:Name="WaitBox" Visibility="Collapsed" Margin="0,16,0,0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Padding="14">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse x:Name="Spinner" Width="20" Height="20" StrokeThickness="3" Stroke="{StaticResource Primary}" StrokeDashArray="3 2" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                                </Ellipse>
                                <TextBlock Text="Đang chờ giám thị phát đề…" Margin="12,0,0,0" FontWeight="SemiBold" Foreground="#1E3A8A" FontSize="15"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="EditReqBox" Visibility="Collapsed" Margin="0,12,0,0" Background="{StaticResource WarnSoft}" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="12" Padding="12">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Sửa thông tin" Style="{StaticResource BtnWarn}" Click="EditInfo_Click"/>
                                <TextBlock x:Name="EditReqText" TextWrapping="Wrap" Foreground="#78350F" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- 3. Làm bài -->
        <Grid x:Name="ExamPanel" Grid.Row="1" Visibility="Collapsed" Background="#E7E5E0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="White" BorderBrush="#D6D3CC" BorderThickness="0,0,0,1" Padding="24,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock x:Name="ProgressText" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ProgressBar x:Name="ProgressBar" Width="120" Height="8" Maximum="1" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{StaticResource Primary}"/>
                        <Border x:Name="TimerBox" Background="#0F172A" CornerRadius="10" Padding="16,6" Margin="0,0,10,0">
                            <TextBlock x:Name="TimerText" Text="00:00" Foreground="White" FontFamily="{StaticResource MonoFont}" FontSize="24" FontWeight="Bold"/>
                        </Border>
                        <Button x:Name="SettingsBtn" Content="⚙" FontSize="18" Width="44" Margin="0,0,10,0" ToolTip="Cài đặt: kiểu gõ, cỡ chữ, công thức toán" Click="Settings_Click"/>
                        <Button x:Name="SubmitBtn" Content="Nộp bài" Style="{StaticResource BtnPrimary}" MinWidth="120" Click="Submit_Click"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ExamTitle" FontWeight="Bold" FontSize="15"/>
                        <TextBlock x:Name="CandidateLine" Style="{StaticResource Hint}" FontSize="13"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsBtn}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="16" Width="320" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Cài đặt" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="KIỂU GÕ TIẾNG VIỆT" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ImeTelex" Content="TELEX" GroupName="ime" IsChecked="True" Margin="0,0,20,0" Checked="Ime_Changed"/>
                            <RadioButton x:Name="ImeVni" Content="VNI" GroupName="ime" Checked="Ime_Changed"/>
                        </StackPanel>
                        <TextBlock x:Name="ImeHint" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                        <TextBlock Text="CỠ CHỮ ĐỀ THI" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="FsSmall" Content="Nhỏ" GroupName="fs" Margin="0,0,20,0" Checked="Fs_Changed"/>
                            <RadioButton x:Name="FsMedium" Content="Vừa" GroupName="fs" IsChecked="True" Margin="0,0,20,0" Checked="Fs_Changed"/>
                            <RadioButton x:Name="FsLarge" Content="Lớn" GroupName="fs" Checked="Fs_Changed"/>
                        </StackPanel>
                        <CheckBox x:Name="MathToggle" Content="Hiện thanh công thức toán học" IsChecked="True" Margin="0,14,0,0" Checked="Math_Changed" Unchecked="Math_Changed"/>
                    </StackPanel>
                </Border>
            </Popup>
            <Border x:Name="NoticeBar" Grid.Row="1" Visibility="Collapsed" Margin="24,12,24,0" CornerRadius="12" Padding="16,10" Background="{StaticResource WarnSoft}" BorderBrush="#FCD34D" BorderThickness="1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Width="36" MinHeight="32" Padding="0" Click="CloseNotice_Click" ToolTip="Đóng nhắc nhở"/>
                    <TextBlock x:Name="NoticeText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#78350F" FontSize="14"/>
                </DockPanel>
            </Border>
            <Grid Grid.Row="2" Margin="24,12,24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="PaperScroll" VerticalScrollBarVisibility="Auto">
                    <Border x:Name="Paper" Background="White" MaxWidth="900" Padding="56,44" Margin="0,0,0,24" BorderBrush="#D6D3CC" BorderThickness="1" CornerRadius="4">
                        <Border.LayoutTransform><ScaleTransform x:Name="PaperScale" ScaleX="1" ScaleY="1"/></Border.LayoutTransform>
                        <StackPanel x:Name="PaperHost" TextElement.FontFamily="{StaticResource PaperFont}" TextElement.FontSize="17"/>
                    </Border>
                </ScrollViewer>
                <Border Grid.Column="2" Background="White" Padding="16" BorderBrush="#D6D3CC" BorderThickness="1" CornerRadius="4">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="PHIẾU TRẢ LỜI" FontWeight="Bold" HorizontalAlignment="Center" FontSize="15"/>
                            <TextBlock Text="Bấm số câu để đến câu đó · tô ô để chọn" Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,2,0,8"/>
                        </StackPanel>
                        <TextBlock x:Name="SubmitRule" DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SheetHost"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
            <Border x:Name="OfflineBar" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24" Background="#7F1D1D" CornerRadius="12" Padding="18,10">
                <TextBlock Text="Mất kết nối với máy chủ · đang kết nối lại… Bài làm vẫn được lưu trên máy." Foreground="White"/>
            </Border>
        </Grid>

        <!-- 4. Đã nộp bài -->
        <Grid x:Name="DonePanel" Grid.Row="1" Visibility="Collapsed" Background="#EEF2F7">
            <Border Background="White" CornerRadius="24" Width="760" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <Border Background="{StaticResource Primary}" CornerRadius="24,24,0,0" Padding="36,30">
                        <DockPanel>
                            <Grid Width="76" Height="76" DockPanel.Dock="Left">
                                <Ellipse Stroke="White" StrokeThickness="4" Fill="#2563EB"/>
                                <TextBlock x:Name="DoneCheck" Text="✓" Foreground="White" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform><ScaleTransform/></TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                            <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="DoneExam" Foreground="#DBEAFE" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DoneHeading" Text="Đã nộp bài thành công" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                                <TextBlock x:Name="DoneLine" Foreground="#DBEAFE" Margin="0,6,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <StackPanel Margin="36,28">
                        <StackPanel x:Name="ScoreBox" Visibility="Collapsed">
                            <TextBlock Text="ĐIỂM TRẮC NGHIỆM (TẠM TÍNH)" FontWeight="Bold" Foreground="{StaticResource Muted}" FontSize="12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock x:Name="ScoreText" FontSize="44" FontWeight="Bold"/>
                                <TextBlock x:Name="ScoreMax" FontSize="16" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="6,0,0,10"/>
                            </StackPanel>
                            <UniformGrid Columns="3" Margin="0,10,0,0">
                                <Border Background="{StaticResource OkSoft}" CornerRadius="12" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock x:Name="RightText" FontSize="22" FontWeight="Bold" Foreground="#166534"/><TextBlock Text="câu đúng" Foreground="#166534"/></StackPanel></Border>
                                <Border Background="{StaticResource BadSoft}" CornerRadius="12" Padding="12" Margin="4,0"><StackPanel><TextBlock x:Name="WrongText" FontSize="22" FontWeight="Bold" Foreground="#B91C1C"/><TextBlock Text="câu sai" Foreground="#B91C1C"/></StackPanel></Border>
                                <Border Background="{StaticResource Ground}" CornerRadius="12" Padding="12" Margin="8,0,0,0"><StackPanel><TextBlock x:Name="BlankText" FontSize="22" FontWeight="Bold"/><TextBlock Text="bỏ trống"/></StackPanel></Border>
                            </UniformGrid>
                            <TextBlock x:Name="EssayPending" Margin="0,12,0,0" Foreground="#5B21B6" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock x:Name="NoScoreText" Text="Kết quả sẽ được giáo viên công bố sau khi chấm." Visibility="Collapsed" FontSize="15"/>
                        <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock x:Name="WaitTitle" Text="Vui lòng ngồi tại chỗ chờ giám thị kết thúc phiên thi" FontWeight="Bold" Foreground="#78350F" FontSize="15"/>
                                <TextBlock x:Name="WaitSub" Text="Không tắt máy, không rời khỏi chỗ ngồi. Máy sẽ tự mở khoá khi giám thị đóng phiên." Foreground="#78350F" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <DockPanel Margin="0,16,0,0">
                            <Button x:Name="ExitBtn" DockPanel.Dock="Right" Content="Thoát ứng dụng" Visibility="Collapsed" Style="{StaticResource BtnPrimary}" Click="Exit_Click"/>
                            <TextBlock x:Name="ReceiptText" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
