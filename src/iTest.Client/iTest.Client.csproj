<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>ITest.Client</RootNamespace>
    <AssemblyName>iTest</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>..\..\assets\iTest.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>iTest</Product>
    <Description>iTest – ứng dụng làm bài thi cho máy thí sinh</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\iTest.ico" Link="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\iTest.Core\iTest.Core.csproj" />
    <ProjectReference Include="..\iTest.UI\iTest.UI.csproj" />
  </ItemGroup>

</Project>
