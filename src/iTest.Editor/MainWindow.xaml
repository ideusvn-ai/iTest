<Window x:Class="ITest.Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iTest-Editor" Icon="app.ico"
        Style="{StaticResource AppWindow}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,10">
            <DockPanel>
                <Button x:Name="QuitBtn" DockPanel.Dock="Right" Content="Thoát" Margin="8,0,0,0" VerticalAlignment="Center" Click="Quit_Click"
                        ToolTip="Thoát iTest-Editor. Nếu bộ đề chưa đóng gói, phiên làm việc được lưu để mở lại lần sau."/>
                <ComboBox x:Name="ImeBox" DockPanel.Dock="Right" Width="132" Margin="8,0,0,0" VerticalAlignment="Center" SelectionChanged="Ime_Changed"
                          ToolTip="Bộ gõ tiếng Việt có sẵn của iTest. Chọn “Tắt bộ gõ” khi soạn đề tiếng Anh hoặc khi máy đã bật Unikey.">
                    <ComboBoxItem Content="Gõ TELEX" Tag="telex"/>
                    <ComboBoxItem Content="Gõ VNI" Tag="vni"/>
                    <ComboBoxItem Content="Tắt bộ gõ" Tag="off"/>
                </ComboBox>
                <WrapPanel x:Name="EditButtons" DockPanel.Dock="Right" Visibility="Collapsed" VerticalAlignment="Center">
                    <Button Content="+ Tạo bộ đề mới" Margin="0,0,8,0" Click="NewSet_Click"/>
                    <Button Content="Nhập từ Word" Margin="0,0,8,0" Click="ImportWord_Click"/>
                    <Button Content="Nhập từ Excel" Margin="0,0,8,0" Click="ImportExcel_Click"/>
                    <Button Content="Tải file Excel mẫu" Margin="0,0,8,0" Click="Template_Click"/>
                    <Button Content="Xuất đề PDF…" Margin="0,0,8,0" Click="ExportPdf_Click" ToolTip="Xuất bộ câu hỏi thành đề thi in giấy (PDF), kèm đáp án từng mã đề"/>
                    <Button x:Name="PackBtn" Content="Đóng gói bộ câu hỏi" Style="{StaticResource BtnTeal}" Click="Pack_Click"/>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="app.ico" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock x:Name="TitleText" Text="iTest-Editor" FontWeight="Bold" FontSize="15"/>
                        <TextBlock x:Name="SaveText" Text="Soạn bộ đề chuẩn cho iTest-Server" Style="{StaticResource Hint}"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Trang đầu: tạo / sửa thông tin bộ đề ============ -->
        <ScrollViewer x:Name="HomePanel" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="28,24" MaxWidth="1200" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="370"/></Grid.ColumnDefinitions>

                <!-- ===== Cột trái: biểu mẫu tạo bộ đề ===== -->
                <StackPanel>
                    <!-- Dải tiêu đề -->
                    <Border CornerRadius="16" Padding="24,20">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1D4ED8" Offset="0"/>
                                <GradientStop Color="#0F766E" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock x:Name="FormTitle" Text="Tạo bộ đề mới" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            <TextBlock x:Name="FormSub" Foreground="#DBEAFE" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="Nhập thông tin bộ đề, phần mềm sẽ tạo sẵn khung câu hỏi và chia điểm cho từng câu."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Padding="24" Margin="0,16,0,0">
                        <StackPanel>
                            <!-- Phần 1: thông tin chung -->
                            <StackPanel Orientation="Horizontal">
                                <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource PrimarySoft}">
                                    <TextBlock Text="1" FontWeight="Bold" Foreground="{StaticResource Primary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Thông tin chung" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                            <UniformGrid Columns="2" Margin="0,6,0,0">
                                <StackPanel Margin="0,0,6,0"><TextBlock Text="Kỳ thi *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FExam"/></StackPanel>
                                <StackPanel Margin="6,0,0,0"><TextBlock Text="Môn thi *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FSubject"/></StackPanel>
                                <StackPanel Margin="0,0,6,0"><TextBlock Text="Người soạn đề *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FAuthor"/></StackPanel>
                                <StackPanel Margin="6,0,0,0"><TextBlock Text="Tổ chuyên môn / Đơn vị" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FUnit"/></StackPanel>
                                <StackPanel Margin="0,0,6,0"><TextBlock Text="Năm học *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FYear" Text="2026 – 2027"/></StackPanel>
                                <StackPanel Margin="6,0,0,0"><TextBlock Text="Sử dụng tài liệu" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="FDocs" SelectedIndex="0"><ComboBoxItem Content="Không được sử dụng tài liệu"/><ComboBoxItem Content="Được sử dụng tài liệu"/></ComboBox></StackPanel>
                                <StackPanel Margin="0,0,6,0"><TextBlock Text="Thời gian làm bài (phút) *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FMinutes" Text="45"/></StackPanel>
                                <StackPanel Margin="6,0,0,0"><TextBlock Text="Số mã đề *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FCodes" Text="4"/></StackPanel>
                            </UniformGrid>

                            <Separator Margin="0,20,0,0" Background="{StaticResource Line}"/>

                            <!-- Phần 2: cấu trúc đề -->
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource PrimarySoft}">
                                    <TextBlock Text="2" FontWeight="Bold" Foreground="{StaticResource Primary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Cấu trúc đề thi" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                            <UniformGrid Columns="2" Margin="0,8,0,0">
                                <Border CornerRadius="12" Padding="14" Margin="0,0,6,0" Background="#F8FAFC" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="PHẦN I · TRẮC NGHIỆM" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Primary}"/>
                                        <UniformGrid Columns="2" Margin="0,6,0,0">
                                            <StackPanel Margin="0,0,4,0"><TextBlock Text="Số câu" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FNMc" Text="36" TextChanged="Total_Changed"/></StackPanel>
                                            <StackPanel Margin="4,0,0,0"><TextBlock Text="Tổng điểm" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FPMc" Text="9" TextChanged="Total_Changed"/></StackPanel>
                                        </UniformGrid>
                                        <TextBlock x:Name="FPerMc" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="12" Padding="14" Margin="6,0,0,0" Background="#F8FAFC" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="PHẦN II · TỰ LUẬN" FontSize="12" FontWeight="Bold" Foreground="#5B21B6"/>
                                        <UniformGrid Columns="2" Margin="0,6,0,0">
                                            <StackPanel Margin="0,0,4,0"><TextBlock Text="Số câu" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FNEs" Text="4" TextChanged="Total_Changed"/></StackPanel>
                                            <StackPanel Margin="4,0,0,0"><TextBlock Text="Tổng điểm" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FPEs" Text="1" TextChanged="Total_Changed"/></StackPanel>
                                        </UniformGrid>
                                        <TextBlock x:Name="FPerEs" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <Border x:Name="FTotalBox" CornerRadius="12" Padding="14,10" Margin="0,12,0,0">
                                <TextBlock x:Name="FTotal" FontWeight="SemiBold"/>
                            </Border>

                            <Separator Margin="0,20,0,0" Background="{StaticResource Line}"/>

                            <!-- Phần 3: bảo mật -->
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource PrimarySoft}">
                                    <TextBlock Text="3" FontWeight="Bold" Foreground="{StaticResource Primary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Bảo mật (không bắt buộc)" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                            <UniformGrid Columns="2" Margin="0,6,0,0">
                                <StackPanel Margin="0,0,6,0"><TextBlock Text="Mật khẩu bộ đề" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="FPass" PasswordChanged="Pass_Changed"/></StackPanel>
                                <StackPanel x:Name="FPass2Row" Margin="6,0,0,0" Visibility="Hidden"><TextBlock Text="Xác nhận mật khẩu *" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="FPass2" PasswordChanged="Pass_Changed"/>
                                    <TextBlock x:Name="FPassMsg" Style="{StaticResource Hint}" Margin="0,4,0,0"/></StackPanel>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Có mật khẩu thì khi mở đề trên iTest-Server phải nhập đúng mật khẩu này."/>

                            <TextBlock x:Name="FMetaNote" Style="{StaticResource Hint}" Foreground="#9A3412" Margin="0,12,0,0" Visibility="Collapsed"
                                       Text="Giảm số câu sẽ xoá các câu ở cuối phần đó. Đổi số câu hoặc tổng điểm của một phần sẽ chia lại điểm cho các câu trong phần đó."/>
                            <TextBlock x:Name="FError" Foreground="{StaticResource Bad}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <DockPanel Margin="0,16,0,0">
                                <Button x:Name="FCancel" Content="Huỷ" DockPanel.Dock="Left" MinWidth="90" Margin="0,0,10,0" Visibility="Collapsed" Click="CancelMeta_Click"/>
                                <Button x:Name="FCreate" Content="Tạo bộ đề &amp; bắt đầu soạn câu hỏi" Style="{StaticResource BtnTeal}" MinHeight="48" Click="Create_Click"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Cột phải: bản nháp & mở bộ đề ===== -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="ClearDraftsBtn" DockPanel.Dock="Right" Content="Xoá tất cả" Style="{StaticResource BtnGhost}"
                                        Padding="10,4" MinHeight="0" VerticalAlignment="Top" Click="DeleteAllDrafts_Click" ToolTip="Xoá mọi bản nháp chưa đóng gói"/>
                                <TextBlock Text="Bản nháp chưa đóng gói" Style="{StaticResource H2}" Margin="0"/>
                            </DockPanel>
                            <TextBlock Text="Câu hỏi đang soạn được tự lưu. Bấm để soạn tiếp." Style="{StaticResource Hint}" Margin="0,2,0,8"/>
                            <ListBox x:Name="DraftList" BorderThickness="0" MaxHeight="420" MouseDoubleClick="DraftList_DoubleClick"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="10,8" Margin="0,3" Background="#F8FAFC">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="✕" Width="28" Height="28" Padding="0" MinHeight="0"
                                                        Style="{StaticResource BtnGhost}" VerticalAlignment="Top" Tag="{Binding}"
                                                        Click="DeleteDraftItem_Click" ToolTip="Xoá bản nháp này"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="NoDraftHint" Text="Chưa có bản nháp nào." Style="{StaticResource Hint}" Margin="2,4,0,0" Visibility="Collapsed"/>
                            <Button Content="Soạn tiếp bản nháp đã chọn" Margin="0,10,0,0" Click="OpenDraft_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Sửa bộ đề đã đóng gói" Style="{StaticResource H2}"/>
                            <TextBlock Text="Mở file .itz (nhập mật khẩu nếu có) để tạo bản nháp mới từ bộ đề." Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                            <Button Content="Mở file .itz…" Click="OpenPackage_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ============ Soạn câu hỏi ============ -->
        <Grid x:Name="EditPanel" Grid.Row="1" Visibility="Collapsed" Margin="20,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorder}" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel><TextBlock x:Name="DoneCount" DockPanel.Dock="Right" Style="{StaticResource Hint}"/><TextBlock Text="Câu hỏi" Style="{StaticResource H2}" Margin="0"/></DockPanel>
                        <ProgressBar x:Name="DoneBar" Height="6" Maximum="1" Margin="0,6,0,8" Foreground="{StaticResource Teal}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <UniformGrid Columns="4">
                            <Button x:Name="QAddBtn" Content="＋ Thêm" Padding="4,0" MinHeight="34" Margin="0,0,3,0" IsTabStop="False" Click="AddQuestion_Click"
                                    ToolTip="Thêm một câu trống ngay sau câu đang chọn (cùng phần). Điểm của phần được chia đều lại."/>
                            <Button x:Name="QDelBtn" Content="Xoá" Padding="4,0" MinHeight="34" Margin="3,0" IsTabStop="False" Click="DeleteQuestion_Click"
                                    ToolTip="Xoá câu đang chọn. Điểm của phần được chia đều lại cho các câu còn lại."/>
                            <Button x:Name="QUpBtn" Content="▲" Padding="4,0" MinHeight="34" Margin="3,0" IsTabStop="False" Click="MoveUp_Click" ToolTip="Chuyển câu đang chọn lên trên (trong cùng phần)"/>
                            <Button x:Name="QDownBtn" Content="▼" Padding="4,0" MinHeight="34" Margin="3,0,0,0" IsTabStop="False" Click="MoveDown_Click" ToolTip="Chuyển câu đang chọn xuống dưới (trong cùng phần)"/>
                        </UniformGrid>
                        <Button x:Name="QAddEssayBtn" Content="＋ Thêm câu tự luận" MinHeight="32" Margin="0,6,0,0" Style="{StaticResource BtnGhost}" IsTabStop="False" Click="AddEssay_Click"
                                ToolTip="Thêm một câu vào cuối phần tự luận"/>
                    </StackPanel>
                    <ListBox x:Name="QList" BorderThickness="0" SelectionChanged="QList_SelectionChanged" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Header}" Visibility="{Binding HeaderVisibility}" FontSize="11" FontWeight="Bold" Foreground="{Binding HeaderBrush}" Margin="0,6,0,2"/>
                                    <DockPanel>
                                        <Ellipse Width="8" Height="8" Fill="{Binding DotBrush}" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                                        <TextBlock Text="{Binding No}" FontWeight="Bold" Width="26" DockPanel.Dock="Left"/>
                                        <TextBlock Text="{Binding PointsText}" DockPanel.Dock="Right" Style="{StaticResource Hint}"/>
                                        <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" Foreground="#334155"/>
                                    </DockPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="22">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="EditorBody">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <TextBlock Text="Điểm" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                <TextBox x:Name="EPoints" Width="80" TextAlignment="Right" TextChanged="EPoints_Changed"/>
                            </StackPanel>
                            <Border x:Name="EBadge" CornerRadius="6" Padding="10,4" Background="#DBEAFE" HorizontalAlignment="Left">
                                <TextBlock x:Name="EBadgeText" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="EMissing" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </DockPanel>
                        <DockPanel x:Name="ETypeRow" Margin="0,14,0,0">
                            <TextBlock Text="Loại câu" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <ComboBox x:Name="EType" Width="240" HorizontalAlignment="Left" SelectionChanged="EType_Changed"/>
                            <TextBlock x:Name="ETypeHint" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                        </DockPanel>
                        <TextBlock Text="Nội dung câu hỏi" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                        <TextBox x:Name="EText" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" VerticalContentAlignment="Top" FontSize="15" TextChanged="EText_Changed"/>
                        <StackPanel Margin="0,6,0,0">
                            <Button x:Name="EMathToggle" Content="∑  Bật công thức toán học" Style="{StaticResource BtnGhost}" MinHeight="30" HorizontalAlignment="Left"
                                    IsTabStop="False" Click="MathToggle_Click"
                                    ToolTip="Hiện công cụ soạn công thức toán. Mặc định tắt cho đề không cần công thức."/>
                            <WrapPanel x:Name="EMathBar" Visibility="Collapsed" Margin="0,6,0,0">
                                <Button Content="∑  Soạn công thức…" Style="{StaticResource BtnPrimary}" MinHeight="30" Margin="0,0,8,4" Click="Formula_Click"
                                        ToolTip="Soạn công thức (phân số, căn, mũ, hệ phương trình…) và chèn vào ô đang soạn."/>
                                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="2,0,0,4"
                                           Text="Công thức được viết giữa hai dấu $, ví dụ: $x^2+1$"/>
                            </WrapPanel>
                        </StackPanel>
                        <Border x:Name="EPreviewBox" Visibility="Collapsed" Margin="0,6,0,0" Padding="12,8" CornerRadius="8" Background="#F8FAFC" BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="XEM TRƯỚC" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
                                <ContentControl x:Name="EPreview"/>
                            </StackPanel>
                        </Border>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Chèn ảnh…" Margin="0,0,8,0" Click="AddImage_Click"/>
                            <Button Content="Chèn âm thanh…" Margin="0,0,8,0" Click="AddAudio_Click"/>
                            <Button x:Name="RemoveMediaBtn" Content="Xoá ảnh/âm thanh" Click="RemoveMedia_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="EMediaText" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                        <Image x:Name="EImage" MaxHeight="200" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                        <StackPanel x:Name="EMcPanel" Margin="0,14,0,0">
                            <TextBlock x:Name="EOptTitle" Text="Phương án · chọn đáp án đúng" Style="{StaticResource FieldLabel}"/>
                            <ItemsControl x:Name="EOptions"/>
                        </StackPanel>
                        <StackPanel x:Name="EShortPanel" Margin="0,14,0,0" Visibility="Collapsed">
                            <TextBlock Text="Đáp án đúng" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="EShortKey" FontSize="15" TextChanged="EShortKey_Changed"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="Nhiều cách viết được chấp nhận thì cách nhau bằng dấu chấm phẩy, ví dụ: 0,5; 1/2. Khi chấm, máy bỏ qua khoảng trắng, chữ hoa/thường và coi dấu phẩy như dấu chấm."/>
                        </StackPanel>
                        <StackPanel x:Name="EEsPanel" Margin="0,14,0,0" Visibility="Collapsed">
                            <TextBlock Text="Đáp án / hướng dẫn chấm (không hiển thị cho thí sinh)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="EGuide" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" VerticalContentAlignment="Top" TextChanged="EGuide_Changed"/>
                        </StackPanel>
                        <DockPanel Margin="0,18,0,0">
                            <Button Content="← Câu trước" DockPanel.Dock="Left" Click="Prev_Click"/>
                            <Button Content="Câu sau →" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Click="Next_Click"/>
                            <Button Content="Đến câu còn thiếu" Style="{StaticResource BtnWarn}" HorizontalAlignment="Right" Margin="0,0,8,0" IsTabStop="False" Click="NextMissing_Click"/>
                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"
                                       Text="Nhập nhanh: Tab sang ô tiếp theo (ô cuối → câu sau) · Ctrl+Space trong ô phương án: đánh dấu đáp án đúng · Ctrl+Enter: câu sau"/>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Tổng điểm" Style="{StaticResource H2}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TotalText" FontSize="34" FontWeight="Bold"/>
                                <TextBlock Text=" / 10 điểm" FontSize="15" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="4,0,0,8"/>
                            </StackPanel>
                            <ProgressBar x:Name="TotalBar" Height="8" Maximum="10"/>
                            <Border x:Name="TotalMsgBox" CornerRadius="8" Padding="10,6" Margin="0,8,0,0"><TextBlock x:Name="TotalMsg" FontWeight="SemiBold" TextWrapping="Wrap"/></Border>
                            <TextBlock x:Name="SumParts" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                            <Button Content="Chia đều lại điểm theo tổng từng phần" Margin="0,10,0,0" Click="ResetPoints_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Điều kiện đóng gói" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="Check1" TextWrapping="Wrap" Margin="0,2"/>
                            <TextBlock x:Name="Check2" TextWrapping="Wrap" Margin="0,2"/>
                            <TextBlock x:Name="Check3" TextWrapping="Wrap" Margin="0,2"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Margin="0,14,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Sửa" MinHeight="30" Click="EditMeta_Click"/>
                                <TextBlock Text="Thông tin bộ đề" Style="{StaticResource H2}"/>
                            </DockPanel>
                            <ItemsControl x:Name="MetaRows">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <TextBlock Text="{Binding V}" FontWeight="SemiBold" DockPanel.Dock="Right" TextAlignment="Right"/>
                                            <TextBlock Text="{Binding K}" Foreground="{StaticResource Muted}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ImportNoteBox" Visibility="Collapsed" Margin="0,14,0,0" Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="12" Padding="12">
                        <TextBlock x:Name="ImportNote" TextWrapping="Wrap" Foreground="#7C2D12"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
