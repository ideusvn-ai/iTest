<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>ITest.Editor</RootNamespace>
    <AssemblyName>iTest-Editor</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>..\..\assets\iTest-Editor.ico</ApplicationIcon>
    <Product>iTest-Editor</Product>
    <Description>iTest-Editor – soạn bộ đề</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.*" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.*" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\iTest-Editor.ico" Link="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\iTest.Core\iTest.Core.csproj" />
    <ProjectReference Include="..\iTest.UI\iTest.UI.csproj" />
  </ItemGroup>

</Project>
